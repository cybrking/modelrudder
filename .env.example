# Run smart-codex setup or smart-claude setup to open this shared private configuration.
# All settings below are disabled until you explicitly uncomment them.
# Jev account signup/login and API keys: https://console.typesafe.ai/keys
# Official instructions: https://docs.typesafe.ai/introduction/quickstart
# Provider fees are separate from this free software and your native coding subscription.
# Enter your own key in this local file; never paste it into agent chat or commit it.
# TYPESAFE_API_KEY=
# Advisory classification sends only the current eligible task text to TypeSafe.
# Uncomment the consent setting only after reviewing the README data flow.
# ALLOW_JEV_CLASSIFICATION=true
# SMART_CODEX_CLASSIFIER=direct
# Optional global kill switch; false disables classification even with Jev consent.
# ALLOW_CLASSIFICATION=false
