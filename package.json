{
  "name": "modelrudder",
  "version": "0.1.0-preview.7",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Experimental local model routing for native Codex and Claude Code",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cybrking/modelrudder.git"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "eval:routing": "node --test test/claude-mod.test.ts test/claude-routing.test.ts test/context-eligibility.test.ts test/turn-lifecycle.test.ts test/effort-routing.test.ts",
    "typecheck": "tsc --noEmit",
    "install-cli": "node -- src/install-cli.ts",
    "smart-codex": "node --env-file-if-exists=.env.local src/smart-codex.ts",
    "smart-claude": "node --env-file-if-exists=.env.local src/smart-claude.ts",
    "doctor:claude": "node --env-file-if-exists=.env.local src/smart-claude.ts doctor",
    "doctor": "node --env-file-if-exists=.env.local src/doctor.ts",
    "report": "node src/usage-report.ts",
    "package:release": "node scripts/release.ts",
    "package:pilot": "node scripts/package-pilot.ts",
    "test:native-protocol": "node scripts/native-protocol-smoke.ts",
    "test:claude-native": "node scripts/claude-native-smoke.ts"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
